# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Supabase "Connection string" (owner/postgres role) — Project Settings > Database.
# Used only for pre-session auth lookups and admin invite creation.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# app_user role connection — created by sql/schema.sql. Leave unset until that role
# exists; the app falls back to DATABASE_URL (which means RLS isn't actually enforced
# yet — fill this in as soon as you've run schema.sql / apply_schema.py).
TENANT_DATABASE_URL=postgresql://app_user:password@host:5432/postgres

# Any long random string — signs the session cookie.
JWT_SECRET=change-me-to-a-long-random-string

# A separate long random string (do not reuse JWT_SECRET) — deterministically hashes
# `username` at rest (HMAC-SHA256), e.g. `openssl rand -hex 32`.
USERNAME_HASH_PEPPER=change-me-to-a-different-long-random-string

# A Fernet key — encrypts `household_name`/`username` at rest so raw DB browsing can't
# read them, while the app itself can still display them. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key

# Printed by scripts/seed.py after it creates the demo/owner household.
OWNER_HOUSEHOLD_ID=

# The frontend's origin, for CORS.
CORS_ALLOW_ORIGIN=http://localhost:3000

ENVIRONMENT=development
